<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>KHIMAIRA __VERSION__</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <options customize="allow" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <domains enable_localSystem="true"/>
    <choices-outline>
        <line choice="vst3"/>
        <line choice="au"/>
        <line choice="app"/>
    </choices-outline>
    <choice id="vst3" title="VST3 plug-in" description="Ableton Live, Cubase, Studio One, FL Studio, Bitwig, Reaper…">
        <pkg-ref id="music.khimaira.v12.vst3"/>
    </choice>
    <choice id="au" title="AU MIDI FX" description="Logic Pro MIDI FX slot, before a software instrument">
        <pkg-ref id="music.khimaira.v12.au"/>
    </choice>
    <choice id="app" title="Standalone app" description="MIDI chart editor and export; no built-in sound">
        <pkg-ref id="music.khimaira.v12.app"/>
    </choice>
    <pkg-ref id="music.khimaira.v12.vst3" version="__VERSION__">khimaira-vst3.pkg</pkg-ref>
    <pkg-ref id="music.khimaira.v12.au" version="__VERSION__">khimaira-au.pkg</pkg-ref>
    <pkg-ref id="music.khimaira.v12.app" version="__VERSION__">khimaira-app.pkg</pkg-ref>
</installer-gui-script>
